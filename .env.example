# DemoToSkill Environment Configuration
# Target: Best Use of Gemma 4 Only (Hacktoberfest Hack Day, Margao 2026)

# Google GenAI / Gemini API Key (Get free key from Google AI Studio)
# NEVER COMMIT YOUR REAL API KEY
GEMINI_API_KEY=your_gemini_api_key_here

# Gemma 4 Model Selection
# Fast multimodal model for step understanding & verification
GEMMA_MODEL=gemma-4-26b-a4b-it

# High-accuracy model for Set-of-Marks visual repair/healing (supports thinking mode)
GEMMA_REPAIR_MODEL=gemma-4-31b-it

# Server & Port Configuration
BACKEND_PORT=8000
FRONTEND_PORT=5173
DEMO_APP_PORT=8080

# Concurrency & Settle Delays
MAX_CONCURRENT_GEMMA_CALLS=3
NETWORK_IDLE_TIMEOUT_MS=1500
POST_ACTION_SETTLE_MS=300
IMAGE_RESIZE_MAX_WIDTH=1024
IMAGE_JPEG_QUALITY=70
